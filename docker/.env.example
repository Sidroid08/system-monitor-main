# Local vmagent AWS discovery settings.
# Copy to docker/.env for local use only. Never commit real AWS credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Local MySQL for backend development. These are placeholders only.
MYSQL_ROOT_PASSWORD=root-local-password
MYSQL_DATABASE=sidroid
MYSQL_USER=sidroid_user
MYSQL_PASSWORD=local-dev-password

# Local Redis for BullMQ uptime workers.
REDIS_URL=redis://redis:6379
