# Local vmagent AWS discovery settings.
# Copy to docker/.env for local use only. Never commit real AWS credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Backend API runtime. Placeholders only; use real secrets in docker/.env.
NODE_ENV=production
BACKEND_HOST_PORT=5000
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRES_IN=15m
API_KEY_PEPPER=replace-with-a-long-random-api-key-pepper
CORS_ORIGIN=http://localhost:3000

# Local MySQL for backend development. These are placeholders only.
MYSQL_HOST_PORT=3306
MYSQL_ROOT_PASSWORD=root-local-password
MYSQL_DATABASE=sidroid
MYSQL_USER=sidroid_user
MYSQL_PASSWORD=local-dev-password

# Local Redis for BullMQ uptime workers.
REDIS_URL=redis://redis:6379

# API rate limits. Redis is recommended in Compose; memory is local/dev fallback.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE=redis
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
INGEST_RATE_LIMIT_WINDOW_SECONDS=60
INGEST_RATE_LIMIT_MAX=120
QUERY_RATE_LIMIT_WINDOW_SECONDS=60
QUERY_RATE_LIMIT_MAX=300

# Request-level telemetry ingestion caps.
TELEMETRY_MAX_ACCEPTED_LOGS_PER_REQUEST=100
TELEMETRY_MAX_ACCEPTED_METRICS_PER_REQUEST=100

# Telemetry retention.
LOG_RETENTION_DAYS=30
METRIC_RETENTION_DAYS=30
TELEMETRY_RETENTION_BATCH_SIZE=1000
