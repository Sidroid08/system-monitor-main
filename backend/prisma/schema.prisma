generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   String               @id @default(uuid())
  name                 String
  slug                 String               @unique
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  users                User[]
  members              OrganizationMember[]
  awsAccounts          AwsAccount[]
  monitoredInstances   MonitoredInstance[]
  monitoredServices    MonitoredService[]
  uptimeChecks         UptimeCheck[]
  apiKeys              ApiKey[]
  alerts               Alert[]
  alertRules           AlertRule[]
  notificationChannels NotificationChannel[]
  syncLogs             SyncLog[]
  auditLogs            AuditLog[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  email          String       @unique
  passwordHash   String
  role           UserRole     @default(VIEWER)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    OrganizationMember[]
  createdApiKeys ApiKey[]     @relation("ApiKeyCreatedBy")
  createdServices MonitoredService[] @relation("ServiceCreatedBy")
  auditLogs      AuditLog[]

  @@index([organizationId])
  @@map("users")
}

model OrganizationMember {
  id             String          @id @default(uuid())
  organizationId String
  userId         String
  role           OrgMemberRole   @default(VIEWER)
  status         OrgMemberStatus @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model AwsAccount {
  id              String              @id @default(uuid())
  organizationId  String
  accountName     String
  accountId       String              @unique
  region          String
  accessKeyId     String?
  secretAccessKey String?
  roleArn         String?
  externalId      String?
  authMode        AwsAuthMode         @default(STATIC_KEYS)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monitoredInstances MonitoredInstance[]
  syncLogs           SyncLog[]

  @@index([organizationId])
  @@map("aws_accounts")
}

model MonitoredInstance {
  id             String        @id @default(uuid())
  organizationId String
  awsAccountId   String?
  instanceId     String
  instanceName   String?
  hostname       String?
  privateIp      String?
  publicIp       String?
  platform       PlatformType  @default(LINUX)
  serviceType    ServiceType   @default(EC2)
  region         String?
  status         InstanceStatus @default(RUNNING)
  orgLabel       String?
  serviceLabel   String?
  lastSeenAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  awsAccount   AwsAccount?  @relation(fields: [awsAccountId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([awsAccountId])
  @@unique([organizationId, instanceId])
  @@map("monitored_instances")
}

model MonitoredService {
  id                 String               @id @default(uuid())
  organizationId     String
  name               String
  slug               String
  description        String?
  type               MonitoredServiceType
  environment        String               @default("production")
  url                String?
  healthPath         String?
  method             HealthCheckMethod    @default(GET)
  expectedStatusCode Int                  @default(200)
  timeoutMs          Int                  @default(5000)
  intervalSeconds    Int                  @default(60)
  isActive           Boolean              @default(true)
  tags               Json?
  currentStatus      UptimeStatus         @default(UNKNOWN)
  lastCheckedAt      DateTime?
  lastResponseTimeMs Int?
  nextCheckAt        DateTime?
  lastCheckSource    String?              @db.VarChar(40)
  consecutiveFailures Int                 @default(0)
  consecutiveSuccesses Int                @default(0)
  createdByUserId    String?
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("ServiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  uptimeChecks UptimeCheck[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, isActive, nextCheckAt])
  @@index([createdByUserId])
  @@map("monitored_services")
}

model UptimeCheck {
  id             String       @id @default(uuid())
  organizationId String
  serviceId      String
  status         UptimeStatus @default(UNKNOWN)
  httpStatusCode Int?
  responseTimeMs Int?
  errorMessage   String?      @db.VarChar(500)
  checkedAt      DateTime     @default(now())
  checkSource    String       @default("manual")
  metadata       Json?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      MonitoredService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([serviceId])
  @@index([organizationId, serviceId, checkedAt])
  @@map("uptime_checks")
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  prefix         String?   @unique
  keyHash        String    @unique
  scopes         String    @default("[]")
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User?        @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdByUserId])
  @@map("api_keys")
}

// A persistent alert rule that the evaluator checks on every tick.
model AlertRule {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  description    String?
  // PromQL expression. The evaluator appends org label isolation automatically.
  promql         String        @db.Text
  // Comparison operator applied to the scalar result vs threshold.
  condition      RuleCondition
  threshold      Float
  // How many consecutive evaluation cycles the condition must be true before firing.
  // At 30s intervals, duration=2 means condition must hold for ~60s.
  forCycles      Int           @default(1)
  severity       AlertSeverity @default(MEDIUM)
  isActive       Boolean       @default(true)
  // Evaluator state machine fields — managed by the engine, not the API.
  state          RuleState     @default(INACTIVE)
  pendingSince   DateTime?
  lastEvaluatedAt DateTime?
  lastFiredAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alerts       Alert[]

  @@index([organizationId])
  @@index([state])
  @@map("alert_rules")
}

model Alert {
  id             String        @id @default(uuid())
  organizationId String
  // Null for manually created alerts.
  ruleId         String?
  title          String
  description    String?
  severity       AlertSeverity @default(MEDIUM)
  source         String?
  metricName     String?
  instanceId     String?
  status         AlertStatus   @default(OPEN)
  triggeredAt    DateTime      @default(now())
  resolvedAt     DateTime?
  // Labels from the metric that fired this alert (stored as JSON string).
  labels         String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alertRule    AlertRule?   @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
  @@index([ruleId])
  @@map("alerts")
}

// Notification channel: email, Slack webhook, or generic HTTP webhook.
model NotificationChannel {
  id             String      @id @default(uuid())
  organizationId String
  name           String
  type           ChannelType
  // Channel-specific config stored as encrypted JSON string.
  // EMAIL:   { to: string[], fromName?: string }
  // SLACK:   { webhookUrl: string }
  // WEBHOOK: { url: string, method?: string, headers?: Record<string,string> }
  config         String      @db.Text
  // Minimum severity that triggers this channel (inclusive).
  minSeverity    AlertSeverity @default(LOW)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("notification_channels")
}

model SyncLog {
  id                  String     @id @default(uuid())
  organizationId      String
  awsAccountId        String
  status              SyncStatus
  startedAt           DateTime   @default(now())
  finishedAt          DateTime?
  errorMessage        String?    @db.Text
  resourcesDiscovered Int        @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  awsAccount   AwsAccount   @relation(fields: [awsAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([awsAccountId])
  @@map("sync_logs")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor       User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorUserId])
  @@index([action])
  @@map("audit_logs")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

enum OrgMemberRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

enum OrgMemberStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum AwsAuthMode {
  STATIC_KEYS
  ASSUME_ROLE
}

enum PlatformType {
  LINUX
  WINDOWS
}

enum ServiceType {
  EC2
  VM
  BARE_METAL
  CONTAINER
}

enum InstanceStatus {
  RUNNING
  STOPPED
  TERMINATED
  UNKNOWN
}

enum MonitoredServiceType {
  HTTP
  API
  WEB
  EC2
  CUSTOM
}

enum HealthCheckMethod {
  GET
  HEAD
}

enum UptimeStatus {
  UP
  DOWN
  DEGRADED
  UNKNOWN
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum RuleCondition {
  GT
  GTE
  LT
  LTE
  EQ
}

enum RuleState {
  INACTIVE
  PENDING
  FIRING
}

enum ChannelType {
  EMAIL
  SLACK
  WEBHOOK
}

enum SyncStatus {
  STARTED
  SUCCESS
  FAILED
}
