# Runtime
PORT=5000
NODE_ENV=development

# Auth
# Use a long random value. Production requires at least 32 characters.
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRES_IN=7d

# API key hashing pepper. Use a separate long random value outside local dev.
API_KEY_PEPPER=replace-with-a-long-random-api-key-pepper

# CORS
# Use the frontend origin in production. Use http://localhost:3000 for local UI work.
CORS_ORIGIN=http://localhost:3000

# Prisma database URL
DATABASE_URL=mysql://sidroid_user:local-dev-password@localhost:3306/sidroid

# Optional DB connection metadata used by legacy/config helpers.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sidroid
DB_USER=sidroid_user
DB_PASSWORD=local-dev-password
DB_CONNECTION_LIMIT=10

# AWS defaults for discovery. Do not store real AWS credentials in this file.
AWS_DEFAULT_REGION=us-east-1
AWS_SYNC_DEFAULT_REGION=us-east-1

# Metrics backend
VICTORIA_METRICS_URL=http://localhost:8428

# Alert evaluator
EVALUATOR_INTERVAL_SECONDS=30

# Redis/BullMQ uptime worker
REDIS_URL=redis://localhost:6379
UPTIME_SCHEDULER_INTERVAL_SECONDS=15
UPTIME_SCHEDULER_SCAN_LIMIT=100
UPTIME_WORKER_CONCURRENCY=5

# vmagent file_sd target output
TARGETS_DIR_PATH=../configs/targets

# SMTP notification delivery. Leave blank unless testing email locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sidroid Alerts <alerts@sidroid.local>

# Telemetry ingestion retention (days). Defaults: 30 days each.
LOG_RETENTION_DAYS=30
METRIC_RETENTION_DAYS=30
# How many rows to delete per batch during retention cleanup.
TELEMETRY_RETENTION_BATCH_SIZE=1000
